{
  "compilerOptions": {
    "target": "ES6",
    "module": "ESNext",
    "outDir": "js",
    "strict": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["js/**/*.ts"],
  "exclude": ["node_modules", "css", "scss", "assets"]
}
